{
  "expo": {
    "name": "GH Trust",
    "slug": "ghtrust",
    "owner": "gh-trust",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ghtrust",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "ng.ghtrust.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIRequiresFullScreen": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ng.ghtrust.app",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "allowBackup": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B2F6B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "GH Trust uses Face ID to unlock your account on this phone."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "GH Trust uses the camera to check it's really you when you open your account, to photograph documents for your loan application, and to take your profile photo.",
          "photosPermission": "GH Trust uses your photos to attach documents to your loan application and to choose your profile photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "GH Trust uses the camera to check it's really you when you open your account, to photograph documents for your loan application, and to take your profile photo.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#101F63",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#F4F7FB",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2838921e-8603-44b4-9a7c-8943a6015284"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/2838921e-8603-44b4-9a7c-8943a6015284",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}

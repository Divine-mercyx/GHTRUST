{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "channel": "development",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "development"
      },
      "autoIncrement": true
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ghtrust-production.up.railway.app"
      },
      "channel": "preview",
      "autoIncrement": true
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ghtrust-production.up.railway.app",
        "EXPO_PUBLIC_ANDROID_STORE_URL": "https://play.google.com/store/apps/details?id=ng.ghtrust.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

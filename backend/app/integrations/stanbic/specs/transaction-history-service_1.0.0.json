                        "content": {
                            "application/json": {
                                "schema": {
                                    "title": "response",
                                    "type": "object",
                                    "example": {
                                        "responsecode": "55",
                                        "responseMsg": "Service Currently Unavailable"
                                    }
                                }
                            }
                        }
                    }
                },
                "summary": "This API fetches the history of transactions for an account within a specified range",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RequestBody"
                            }
                        }
                    },
                    "required": true,
                    "description": "This request takes in the account number and date range"
                }
            }
        }

# Application
APP_NAME=GH Trust MFB API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ghtrust
POSTGRES_PASSWORD=ghtrust_secret
POSTGRES_DB=ghtrust_mfb
DATABASE_URL=postgresql+asyncpg://ghtrust:ghtrust_secret@postgres:5432/ghtrust_mfb
# Pool per API worker process. Keep WEB_CONCURRENCY × (POOL_SIZE + MAX_OVERFLOW) < Postgres max_connections.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
# Postgres cancels any single query running longer than this.
DB_STATEMENT_TIMEOUT_MS=15000
# API worker processes in the container (Dockerfile).
WEB_CONCURRENCY=2

# Redis (cache + Celery broker)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Celery beat / workers
CELERY_TASK_ALWAYS_EAGER=false

# Dojah KYC (https://docs.dojah.io)
DOJAH_BASE_URL=https://api.dojah.io
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
DOJAH_MOCK=true
# Development test mode (APP_ENV=development, mocks on): the sandbox BVN identity
# uses this phone, and OTP responses include the code so the dev app fills it in.
DOJAH_MOCK_PHONE=

# Payment rail — Monnify (default)
PAYMENT_PROVIDER=monnify

# Zest Payments (Dynamic VA API — see merchant Notion documentation)
# ZEST_BASE_URL=https://api.dev.gateway.zestpayment.com/payment-engine
ZEST_BASE_URL=https://api.dev.gateway.zestpayment.com/payment-engine
ZEST_PUBLIC_KEY=
ZEST_SECRET_KEY=
ZEST_MOCK=true
ZEST_AUTH_ENCRYPTION_IV=
ZEST_AUTH_ENCRYPTION_KEY=
ZEST_DYNAMIC_VAS_REQUEST_TYPE=GENERATE_TEMPORARY_VIRTUAL_ACCOUNT
ZEST_TRANSFER_STATUS_VAS_REQUEST_TYPE=TRANSFER_PAYMENT_STATUS
ZEST_VA_EXPIRY_MINUTES=5

# Monnify (https://developers.monnify.com/api)
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_WALLET_ACCOUNT_NUMBER=
MONNIFY_MOCK=true
MONNIFY_WEBHOOK_IP_CHECK=false

# Stanbic IBTC bank partner (https://developer.stanbicibtc.com/sandbox/)
# Set PAYMENT_PROVIDER=stanbic to route wallet + disbursement through Stanbic.
# Contract is UNCONFIRMED until sandbox access is granted — see
# app/integrations/stanbic/constants.py (TODO(stanbic-spec) markers).
STANBIC_BASE_URL=https://api.sandbox.stanbicibtc.com
# Leave STANBIC_TOKEN_URL blank to send X-IBM-Client-Id / X-IBM-Client-Secret
# (IBM API Connect gateway). Set it to enable OAuth2 client-credentials instead.
STANBIC_TOKEN_URL=
STANBIC_CLIENT_ID=
STANBIC_CLIENT_SECRET=
STANBIC_MERCHANT_ID=
STANBIC_SETTLEMENT_ACCOUNT_NUMBER=
STANBIC_WEBHOOK_SECRET=
STANBIC_MOCK=true

# Paystack (legacy / optional — https://paystack.com/docs/api/)
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_MOCK=true
PAYSTACK_PREFERRED_BANK=test-bank

# OTP / SMS. SMS_MOCK=true logs the OTP to the console (dev only).
# SMS_PROVIDER: termii (leave empty with SMS_MOCK=true for local development).
SMS_MOCK=true
SMS_PROVIDER=
# Termii (SMS_PROVIDER=termii, SMS_MOCK=false): key and base URL from your Termii
# dashboard; sender ID must be approved by Termii. Channel "dnd" reaches DND numbers.
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://v3.api.termii.com
TERMII_CHANNEL=dnd

# Auth tokens — short-lived access JWT + rotating refresh token per device
CUSTOMER_ACCESS_TOKEN_MINUTES=15
CUSTOMER_REFRESH_TOKEN_DAYS=30
STAFF_ACCESS_TOKEN_MINUTES=10
STAFF_REFRESH_TOKEN_HOURS=12
# Staff sessions end after this many minutes without activity (next launch shows sign-in).
STAFF_SESSION_IDLE_MINUTES=20

# Serve /docs + /openapi.json (independent of DEBUG). Enable on staging for the
# mobile team; keep false in production.
ENABLE_API_DOCS=true

# Reverse proxies in front of the API that append to X-Forwarded-For.
# 0 = ignore the header (direct exposure). 1 = behind one load balancer.
TRUSTED_PROXY_COUNT=0

# Largest JSON request body accepted (uploads use MAX_UPLOAD_SIZE_MB).
MAX_JSON_BODY_KB=256

# Error tracking (Sentry). Empty = off. No request bodies, cookies, auth headers or IPs are sent.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Rate limits (skipped when APP_ENV=development)
RATE_LIMIT_ENABLED=true
# Ceiling on all API requests per client IP (webhooks/health exempt).
RATE_LIMIT_API_PER_IP_MINUTE=300
RATE_LIMIT_BVN_PER_IP_HOUR=5
RATE_LIMIT_BVN_PER_BVN_DAY=3
RATE_LIMIT_OTP_SEND_PER_PHONE_15MIN=3
RATE_LIMIT_OTP_SEND_PER_IP_HOUR=10
RATE_LIMIT_OTP_VERIFY_PER_IP_HOUR=20
RATE_LIMIT_LOGIN_REQUEST_PER_PHONE_15MIN=5

DEFAULT_BRANCH=Lagos Main

# First super admin (seeded via `make seed`). Required — seed aborts if unset.
# The admin portal login OTP is sent to this phone.
SEED_SUPER_ADMIN_NAME=
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PHONE=

# Mobile app remote config — GET /api/v1/app/config
# Clients sending X-App-Platform + X-App-Version below the minimum get 426.
APP_MIN_VERSION_IOS=1.0.0
APP_MIN_VERSION_ANDROID=1.0.0
APP_LATEST_VERSION_IOS=
APP_LATEST_VERSION_ANDROID=
MAINTENANCE_MODE=false
SUPPORT_PHONE=
SUPPORT_EMAIL=
# Optional app modules to show: wallet,savings,investments,contributions,food_basket
FEATURE_FLAGS=

# Application
APP_NAME=GH Trust MFB API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ghtrust
POSTGRES_PASSWORD=ghtrust_secret
POSTGRES_DB=ghtrust_mfb
DATABASE_URL=postgresql+asyncpg://ghtrust:ghtrust_secret@postgres:5432/ghtrust_mfb
# Pool per API worker process. Keep WEB_CONCURRENCY × (POOL_SIZE + MAX_OVERFLOW) < Postgres max_connections.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
# Postgres cancels any single query running longer than this.
DB_STATEMENT_TIMEOUT_MS=15000
# API worker processes in the container (Dockerfile).
WEB_CONCURRENCY=2

# Redis (cache + Celery broker)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Celery beat / workers
CELERY_TASK_ALWAYS_EAGER=false

# Dojah KYC (https://docs.dojah.io)
# Sandbox: https://sandbox.dojah.io (test BVN 22222222222)
DOJAH_BASE_URL=https://api.dojah.io
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
DOJAH_MOCK=true
# Development test mode (APP_ENV=development, mocks on): the sandbox BVN identity
# uses this phone, and OTP responses include the code so the dev app can show it.
DOJAH_MOCK_PHONE=
# Account opening matches a selfie to the BVN photo after the SMS code.
# Threshold 50-100 (Dojah default 90). After the last failed attempt the BVN cools down
# (DOJAH_SELFIE_COOLDOWN_MINUTES) before sign-up can start again.
DOJAH_SELFIE_REQUIRED=true
DOJAH_SELFIE_THRESHOLD=90
DOJAH_SELFIE_MAX_ATTEMPTS=3
DOJAH_SELFIE_COOLDOWN_MINUTES=60
# The app captures the face live; Dojah checks it is a real person (not a photo of a
# photo or a screen) before matching. A failed check uses up an attempt.
DOJAH_LIVENESS_REQUIRED=true
DOJAH_LIVENESS_MIN_PROBABILITY=0.5

# Payment rail — Monnify (default)
PAYMENT_PROVIDER=monnify

# Zest Payments (Dynamic VA API — see merchant Notion documentation)
# ZEST_BASE_URL=https://api.dev.gateway.zestpayment.com/payment-engine
ZEST_BASE_URL=https://api.dev.gateway.zestpayment.com/payment-engine
ZEST_PUBLIC_KEY=
ZEST_SECRET_KEY=
ZEST_MOCK=true
ZEST_AUTH_ENCRYPTION_IV=
ZEST_AUTH_ENCRYPTION_KEY=
ZEST_DYNAMIC_VAS_REQUEST_TYPE=GENERATE_TEMPORARY_VIRTUAL_ACCOUNT
ZEST_TRANSFER_STATUS_VAS_REQUEST_TYPE=TRANSFER_PAYMENT_STATUS
ZEST_VA_EXPIRY_MINUTES=5

# Monnify (https://developers.monnify.com/api)
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_WALLET_ACCOUNT_NUMBER=
MONNIFY_MOCK=true
MONNIFY_WEBHOOK_IP_CHECK=false

# Stanbic IBTC bank partner (https://developer.stanbicibtc.com/sandbox/)
# Set PAYMENT_PROVIDER=stanbic to route wallet + disbursement through Stanbic.
# Contract is UNCONFIRMED until sandbox access is granted — see
# app/integrations/stanbic/constants.py (TODO(stanbic-spec) markers).
STANBIC_BASE_URL=https://api.sandbox.stanbicibtc.com
STANBIC_ACCOUNT_OPENING_BASE_URL=https://testapi.stanbicibtc.com/test/sandbox/account-opening
STANBIC_ACCOUNT_OPENING_STATUS_BASE_URL=https://testapi.stanbicibtc.com/test/sandbox
STANBIC_CURRENT_ACCOUNT_BASE_URL=https://testapi.stanbicibtc.com/test/sandbox/current-account-opening
STANBIC_NPS_BASE_URL=https://testapi.stanbicibtc.com/test/sandbox/nps
STANBIC_NAME_ENQUIRY_BASE_URL=https://testapi.stanbicibtc.com/test/sandbox/nameenquiry
STANBIC_TRANSACTION_HISTORY_BASE_URL=https://testapi.stanbicibtc.com/test/sandbox/transaction-history-service
STANBIC_CREDIT_CHECK_BASE_URL=https://testapi.stanbicibtc.com/test/sandbox/credit-check-services
STANBIC_OAUTH_TOKEN_URL=https://testapi.stanbicibtc.com/test/sandbox/mynativeoauthprovider/oauth2/token
STANBIC_PORTAL_SANDBOX=true
STANBIC_CREDIT_CHECK_ENABLED=false
# Leave STANBIC_TOKEN_URL blank to send X-IBM-Client-Id / X-IBM-Client-Secret
# (IBM API Connect gateway). Set it to enable OAuth2 client-credentials instead.
STANBIC_TOKEN_URL=
STANBIC_CLIENT_ID=
STANBIC_CLIENT_SECRET=
STANBIC_MERCHANT_ID=
STANBIC_SETTLEMENT_ACCOUNT_NUMBER=
STANBIC_WEBHOOK_SECRET=
STANBIC_MOCK=true

# Paystack (legacy / optional — https://paystack.com/docs/api/)
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_MOCK=true
PAYSTACK_PREFERRED_BANK=test-bank

# Push notifications (Expo push service). PUSH_MOCK=true logs pushes instead of sending.
# The Celery worker + beat must run: deliver_notifications sends every minute and
# send_loan_reminders queues repayment reminders at 08:00 Lagos time.
# EXPO_PUSH_ACCESS_TOKEN only if "enhanced push security" is on for the Expo project.
PUSH_MOCK=true
EXPO_PUSH_ACCESS_TOKEN=

# OTP / SMS. SMS_MOCK=true logs the OTP to the console (dev only).
# SMS_PROVIDER: termii (leave empty with SMS_MOCK=true for local development).
SMS_MOCK=true
# Test deployment (non-production, SMS_MOCK=true): return the code to the app so testers
# can sign in without SMS. Local development does this by default.
OTP_TEST_ECHO=false
# Demo sign-in for testers and app-store review: these numbers (comma-separated) get
# DEMO_OTP instead of an SMS; everyone else is unchanged. `python scripts/seed.py` opens
# a "Demo Customer" account for each number that isn't staff, with the PINs below
# (re-running resets them). In production: staff never get the demo code, money can't
# leave a demo account, and DEMO_OTP can't be guessable (000000, 123456...).
DEMO_PHONES=
DEMO_OTP=
# Test servers only (production refuses it): 11-digit BVNs that simulate sign-up without
# Dojah. Each gets a made-up identity ("Demo Applicant") with phone 070 + the BVN's last
# 8 digits, the code is DEMO_OTP, and the face check always passes. Entering the BVN
# again starts over (the previous attempt is closed). Avoid real BVNs, which start with 22.
# Example: DEMO_BVNS=00000000001,00000000002
DEMO_BVNS=
DEMO_LOGIN_PIN=
DEMO_TRANSACTION_PIN=
SMS_PROVIDER=
# Termii (SMS_PROVIDER=termii, SMS_MOCK=false): key and base URL from your Termii
# dashboard; sender ID must be approved by Termii. Channel "dnd" reaches DND numbers.
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://v3.api.termii.com
TERMII_CHANNEL=dnd

# Auth tokens — short-lived access JWT + rotating refresh token per device
CUSTOMER_ACCESS_TOKEN_MINUTES=15
CUSTOMER_REFRESH_TOKEN_DAYS=30
STAFF_ACCESS_TOKEN_MINUTES=10
STAFF_REFRESH_TOKEN_HOURS=12
# Staff sessions end after this many minutes without activity (next launch shows sign-in).
# Default only: a super admin changes it in the portal (Settings > Security, 5-60 minutes).
STAFF_SESSION_IDLE_MINUTES=30

# Serve /docs + /openapi.json (independent of DEBUG). Enable on staging for the
# mobile team; keep false in production.
ENABLE_API_DOCS=true

# Reverse proxies in front of the API that append to X-Forwarded-For.
# 0 = ignore the header (direct exposure). 1 = behind one load balancer.
TRUSTED_PROXY_COUNT=0

# Largest JSON request body accepted (uploads use MAX_UPLOAD_SIZE_MB).
MAX_JSON_BODY_KB=256
# Largest uploaded file (loan documents), and the sign-up selfie request (several
# camera frames as base64 JSON, so it gets its own allowance).
MAX_UPLOAD_SIZE_MB=30
MAX_SELFIE_BODY_MB=30

# Error tracking (Sentry). Empty = off. No request bodies, cookies, auth headers or IPs are sent.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Rate limits (skipped when APP_ENV=development)
RATE_LIMIT_ENABLED=true
# Ceiling on all API requests per client IP (webhooks/health exempt).
RATE_LIMIT_API_PER_IP_MINUTE=300
RATE_LIMIT_BVN_PER_IP_HOUR=5
RATE_LIMIT_BVN_PER_BVN_DAY=3
RATE_LIMIT_OTP_SEND_PER_PHONE_15MIN=3
RATE_LIMIT_OTP_SEND_PER_IP_HOUR=10
RATE_LIMIT_OTP_VERIFY_PER_IP_HOUR=20
RATE_LIMIT_LOGIN_REQUEST_PER_PHONE_15MIN=5

DEFAULT_BRANCH=Lagos Main

# First super admin (seeded via `make seed`). Required — seed aborts if unset.
# The admin portal login OTP is sent to this phone.
SEED_SUPER_ADMIN_NAME=
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PHONE=

# Mobile app remote config — GET /api/v1/app/config
# Clients sending X-App-Platform + X-App-Version below the minimum get 426.
APP_MIN_VERSION_IOS=1.0.0
APP_MIN_VERSION_ANDROID=1.0.0
APP_LATEST_VERSION_IOS=
APP_LATEST_VERSION_ANDROID=
MAINTENANCE_MODE=false
SUPPORT_PHONE=
SUPPORT_EMAIL=
# WhatsApp number, international format without + (e.g. 2348012345678). Empty hides the button.
SUPPORT_WHATSAPP=
SUPPORT_HOURS=Monday to Friday, 8am to 5pm
# Customers must accept the loan offer in the app before a loan can be paid out.
LOAN_OFFER_ACCEPTANCE_REQUIRED=true
# Optional app modules to show: wallet,savings,investments,contributions,food_basket
FEATURE_FLAGS=
